---
---

<section id="calculator" class="py-20 bg-[var(--color-canvas-soft)] relative border-y border-[var(--color-hairline)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary-deep)] text-xs font-medium uppercase tracking-wider mb-4">
        Interactive Calculator
      </div>
      <h2 class="font-display-xl text-3xl sm:text-4xl text-[var(--color-ink)] mb-4">
        Calculate Your Revenue Acceleration Potential
      </h2>
      <p class="text-base sm:text-lg font-light text-[var(--color-ink-secondary)]">
        See how much unclaimed revenue We Destine can recover for your medical practice or health organization.
      </p>
    </div>

    <div class="max-w-5xl mx-auto bg-white rounded-2xl border border-[var(--color-hairline)] shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-12">
      
      <!-- Calculator Inputs (7 cols) -->
      <div class="p-6 sm:p-10 lg:col-span-7 flex flex-col justify-between">
        <div>
          
          <!-- Step 1: Organization Type -->
          <div class="mb-8">
            <label class="block text-xs font-semibold uppercase tracking-wider text-[var(--color-ink-mute)] mb-3">
              1. Select Practice Type
            </label>
            <div class="grid grid-cols-3 gap-3">
              <button type="button" data-type="medical" class="calc-type-btn active py-2.5 px-3 text-xs sm:text-sm rounded-lg border text-center font-medium transition-all border-[var(--color-primary)] bg-[var(--color-primary-bg-subdued-hover)]/30 text-[var(--color-primary-deep)] cursor-pointer">
                Medical Practice
              </button>
              <button type="button" data-type="dental" class="calc-type-btn py-2.5 px-3 text-xs sm:text-sm rounded-lg border text-center font-medium transition-all border-[var(--color-hairline)] bg-white text-[var(--color-ink-secondary)] hover:border-gray-300 cursor-pointer">
                Dental / DSO
              </button>
              <button type="button" data-type="hospital" class="calc-type-btn py-2.5 px-3 text-xs sm:text-sm rounded-lg border text-center font-medium transition-all border-[var(--color-hairline)] bg-white text-[var(--color-ink-secondary)] hover:border-gray-300 cursor-pointer">
                Hospital System
              </button>
            </div>
          </div>

          <!-- Step 2: Monthly Billing Volume Slider -->
          <div class="mb-8">
            <div class="flex items-center justify-between mb-3">
              <label class="text-xs font-semibold uppercase tracking-wider text-[var(--color-ink-mute)]">
                2. Monthly Billing Collections
              </label>
              <span id="volume-display" class="font-tabular font-light text-xl text-[var(--color-primary-deep)]">
                $250,000 / mo
              </span>
            </div>
            
            <input 
              id="volume-slider" 
              type="range" 
              min="50000" 
              max="2000000" 
              step="25000" 
              value="250000"
              class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[var(--color-primary)]"
            />
            
            <div class="flex items-center justify-between text-xs text-[var(--color-ink-mute)] font-tabular mt-2">
              <span>$50k</span>
              <span>$500k</span>
              <span>$1M</span>
              <span>$2M+</span>
            </div>
          </div>

          <!-- Step 3: Current Denial Rate Slider -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-3">
              <label class="text-xs font-semibold uppercase tracking-wider text-[var(--color-ink-mute)]">
                3. Estimated Current Denial Rate
              </label>
              <span id="denial-display" class="font-tabular font-light text-lg text-[var(--color-ink)]">
                8%
              </span>
            </div>
            
            <input 
              id="denial-slider" 
              type="range" 
              min="3" 
              max="20" 
              step="1" 
              value="8"
              class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[var(--color-primary)]"
            />
            
            <div class="flex items-center justify-between text-xs text-[var(--color-ink-mute)] font-tabular mt-2">
              <span>3% (Low)</span>
              <span>10% (Average)</span>
              <span>20% (High)</span>
            </div>
          </div>

        </div>

        <div class="pt-4 border-t border-[var(--color-hairline)] text-xs font-light text-[var(--color-ink-mute)]">
          *Estimates based on We Destine benchmark client outcomes across 1.2M+ processed healthcare claims.
        </div>
      </div>

      <!-- Calculation Results Box (5 cols) -->
      <div class="bg-[var(--color-brand-dark-900)] text-white p-6 sm:p-10 lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="text-xs font-semibold uppercase tracking-widest text-[var(--color-primary-soft)] mb-2">
            Projected Annual Impact
          </div>
          
          <!-- Big Highlighted Number -->
          <div class="mb-8">
            <div class="text-xs font-light text-slate-400 mb-1">Estimated Net Revenue Lift</div>
            <div id="annual-lift" class="font-tabular font-light text-4xl sm:text-5xl text-emerald-400 tracking-tight">
              +$45,000
            </div>
            <div class="text-xs text-emerald-400/80 mt-1 font-tabular">
              Per year in direct cash flow improvement
            </div>
          </div>

          <!-- Breakdown Cards -->
          <div class="space-y-4 font-tabular">
            
            <div class="flex items-center justify-between p-3.5 rounded-xl bg-white/5 border border-white/10">
              <div>
                <div class="text-xs text-slate-400 font-light">Claim Denial Reduction</div>
                <div class="text-sm font-medium text-white">Target &lt; 1.8%</div>
              </div>
              <div id="denial-savings" class="text-lg font-light text-emerald-400">
                -77%
              </div>
            </div>

            <div class="flex items-center justify-between p-3.5 rounded-xl bg-white/5 border border-white/10">
              <div>
                <div class="text-xs text-slate-400 font-light">Days in A/R Acceleration</div>
                <div class="text-sm font-medium text-white">Avg 18 days payout</div>
              </div>
              <div class="text-lg font-light text-emerald-400">
                -14 Days
              </div>
            </div>

            <div class="flex items-center justify-between p-3.5 rounded-xl bg-white/5 border border-white/10">
              <div>
                <div class="text-xs text-slate-400 font-light">First-Pass Clean Claim Rate</div>
                <div class="text-sm font-medium text-white">AI-Verified Scrubbing</div>
              </div>
              <div class="text-lg font-light text-[var(--color-primary-soft)]">
                98.6%
              </div>
            </div>

          </div>
        </div>

        <div class="mt-8">
          <button onclick="document.getElementById('audit-modal')?.classList.remove('hidden'); document.getElementById('audit-modal')?.classList.add('flex')" class="btn-primary-pill w-full py-3 text-sm cursor-pointer justify-center">
            <span>Claim Your Free Practice Audit</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Calculator Interactive Logic
  const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
  const denialSlider = document.getElementById('denial-slider') as HTMLInputElement;
  const volumeDisplay = document.getElementById('volume-display');
  const denialDisplay = document.getElementById('denial-display');
  const annualLiftDisplay = document.getElementById('annual-lift');
  const denialSavingsDisplay = document.getElementById('denial-savings');
  const typeBtns = document.querySelectorAll('.calc-type-btn');

  let currentTypeMultiplier = 1.0;

  function formatCurrency(val: number): string {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(val);
  }

  function updateCalculator() {
    if (!volumeSlider || !denialSlider || !volumeDisplay || !denialDisplay || !annualLiftDisplay || !denialSavingsDisplay) return;

    const monthlyVol = parseFloat(volumeSlider.value);
    const denialRate = parseFloat(denialSlider.value);

    volumeDisplay.textContent = `${formatCurrency(monthlyVol)} / mo`;
    denialDisplay.textContent = `${denialRate}%`;

    // Formula: Revenue lift = monthlyVol * 12 * (denialRate / 100 * 0.70 + 0.035) * multiplier
    const potentialRecoveryRate = (denialRate * 0.70 / 100) + 0.035;
    const annualLift = monthlyVol * 12 * potentialRecoveryRate * currentTypeMultiplier;

    annualLiftDisplay.textContent = `+${formatCurrency(annualLift)}`;
    
    // Denial reduction %
    const reductionPercent = Math.min(85, Math.round(((denialRate - 1.8) / denialRate) * 100));
    denialSavingsDisplay.textContent = `-${reductionPercent > 0 ? reductionPercent : 60}%`;
  }

  typeBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      typeBtns.forEach(b => {
        b.classList.remove('border-[var(--color-primary)]', 'bg-[var(--color-primary-bg-subdued-hover)]/30', 'text-[var(--color-primary-deep)]');
        b.classList.add('border-[var(--color-hairline)]', 'bg-white', 'text-[var(--color-ink-secondary)]');
      });
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.remove('border-[var(--color-hairline)]', 'bg-white', 'text-[var(--color-ink-secondary)]');
      target.classList.add('border-[var(--color-primary)]', 'bg-[var(--color-primary-bg-subdued-hover)]/30', 'text-[var(--color-primary-deep)]');

      const type = target.dataset.type;
      if (type === 'medical') currentTypeMultiplier = 1.0;
      else if (type === 'dental') currentTypeMultiplier = 0.95;
      else if (type === 'hospital') currentTypeMultiplier = 1.15;

      updateCalculator();
    });
  });

  if (volumeSlider) volumeSlider.addEventListener('input', updateCalculator);
  if (denialSlider) denialSlider.addEventListener('input', updateCalculator);

  // Initialize
  updateCalculator();
</script>
