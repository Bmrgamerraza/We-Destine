---
---

<section class="py-20 bg-[var(--color-canvas-cream)] text-[var(--color-ink)] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Narrative (7 cols) -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-900/10 text-[var(--color-lemon)] text-xs font-semibold uppercase tracking-wider mb-6">
          ★ Proven Health System Case Study
        </div>

        <h2 class="font-display-xl text-3xl sm:text-4xl text-[var(--color-ink)] mb-6 leading-tight">
          "We Destine recovered <span class="underline decoration-[var(--color-primary)] decoration-2 font-normal font-tabular">$1.84M in aged denials</span> in our first 90 days."
        </h2>

        <p class="text-base sm:text-lg font-light text-[var(--color-ink-secondary)] leading-relaxed mb-8">
          "Prior to partnering with We Destine, our 45-physician orthopedic group was struggling with a 14.2% claim denial rate and 48 days in A/R. We Destine's AI scrubbing and dedicated appeal specialists turned around our revenue cycle within one quarter."
        </p>

        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-[var(--color-brand-dark-900)] text-white flex items-center justify-center font-bold text-lg">
            DR
          </div>
          <div>
            <div class="font-medium text-base text-[var(--color-ink)]">Dr. Richard Vance, MD</div>
            <div class="text-xs text-[var(--color-ink-mute)]">Chief Executive Officer · Tri-State Specialty Health Network</div>
          </div>
        </div>
      </div>

      <!-- Right Metric Grid (5 cols) -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-4">
        
        <div class="bg-[var(--color-card-bg)]/80 backdrop-blur-sm p-6 rounded-2xl border border-[var(--color-hairline)] shadow-xs font-tabular">
          <div class="text-xs text-[var(--color-ink-mute)] mb-1">Claim Denial Rate</div>
          <div class="text-3xl sm:text-4xl font-light text-emerald-600 dark:text-emerald-400">1.4%</div>
          <div class="text-[11px] text-[var(--color-ink-mute)] mt-1">Down from 14.2%</div>
        </div>

        <div class="bg-[var(--color-card-bg)]/80 backdrop-blur-sm p-6 rounded-2xl border border-[var(--color-hairline)] shadow-xs font-tabular">
          <div class="text-xs text-[var(--color-ink-mute)] mb-1">Days in A/R</div>
          <div class="text-3xl sm:text-4xl font-light text-[var(--color-primary-deep)]">17 Days</div>
          <div class="text-[11px] text-[var(--color-ink-mute)] mt-1">Accelerated by 31 days</div>
        </div>

        <div class="bg-[var(--color-card-bg)]/80 backdrop-blur-sm p-6 rounded-2xl border border-[var(--color-hairline)] shadow-xs font-tabular">
          <div class="text-xs text-[var(--color-ink-mute)] mb-1">Net Collections</div>
          <div class="text-3xl sm:text-4xl font-light text-emerald-600 dark:text-emerald-400">99.4%</div>
          <div class="text-[11px] text-[var(--color-ink-mute)] mt-1">+$1.84M cash inflow</div>
        </div>

        <div class="bg-[var(--color-card-bg)]/80 backdrop-blur-sm p-6 rounded-2xl border border-[var(--color-hairline)] shadow-xs font-tabular flex flex-col justify-between">
          <div class="text-xs text-[var(--color-ink-mute)]">Staff Satisfaction</div>
          <div class="text-2xl font-light text-[var(--color-ink)]">100% SLA</div>
          <div class="text-[11px] text-emerald-600 dark:text-emerald-400">Zero backlogs</div>
        </div>

      </div>

    </div>

  </div>
</section>
