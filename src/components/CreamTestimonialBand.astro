---
---

<section class="py-12 sm:py-20 bg-[var(--color-canvas-cream)] text-[var(--color-ink)] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Narrative (7 cols) -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-900/10 dark:bg-purple-900/30 text-[var(--color-lemon)] dark:text-purple-300 text-xs font-semibold uppercase tracking-wider mb-4 sm:mb-6">
          ★ Proven Health System Case Study
        </div>

        <h2 class="font-display-xl text-2xl sm:text-4xl text-[var(--color-ink)] mb-4 sm:mb-6 leading-tight">
          "We Destine recovered <span class="underline decoration-[var(--color-primary)] decoration-2 font-normal font-tabular">$1.84M in aged denials</span> in our first 90 days."
        </h2>

        <p class="text-sm sm:text-lg font-light text-[var(--color-ink-secondary)] leading-relaxed mb-6 sm:mb-8">
          "Prior to partnering with We Destine, our 45-physician orthopedic group was struggling with a 14.2% claim denial rate and 48 days in A/R. We Destine's AI scrubbing and dedicated appeal specialists turned around our revenue cycle within one quarter."
        </p>

        <div class="flex items-center gap-3 sm:gap-4">
          <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-[var(--color-brand-dark-900)] dark:bg-[var(--color-primary)] text-white flex items-center justify-center font-bold text-base sm:text-lg shrink-0">
            DR
          </div>
          <div>
            <div class="font-medium text-sm sm:text-base text-[var(--color-ink)]">Dr. Richard Vance, MD</div>
            <div class="text-xs text-[var(--color-ink-mute)]">Chief Executive Officer · Tri-State Specialty Health Network</div>
          </div>
        </div>
      </div>

      <!-- Right Metric Grid (5 cols) -->
      <div class="lg:col-span-5 grid grid-cols-1 xs:grid-cols-2 gap-3 sm:gap-4">
        
        <div class="bg-[var(--color-card-bg)]/80 backdrop-blur-sm p-4 sm:p-6 rounded-2xl border border-[var(--color-hairline)] shadow-xs font-tabular">
          <div class="text-xs text-[var(--color-ink-mute)] mb-1">Claim Denial Rate</div>
          <div class="text-2xl sm:text-4xl font-light text-emerald-600 dark:text-emerald-400">1.4%</div>
          <div class="text-[11px] text-[var(--color-ink-mute)] mt-1">Down from 14.2%</div>
        </div>

        <div class="bg-[var(--color-card-bg)]/80 backdrop-blur-sm p-4 sm:p-6 rounded-2xl border border-[var(--color-hairline)] shadow-xs font-tabular">
          <div class="text-xs text-[var(--color-ink-mute)] mb-1">Days in A/R</div>
          <div class="text-2xl sm:text-4xl font-light text-[var(--color-primary-deep)]">17 Days</div>
          <div class="text-[11px] text-[var(--color-ink-mute)] mt-1">Accelerated by 31 days</div>
        </div>

        <div class="bg-[var(--color-card-bg)]/80 backdrop-blur-sm p-4 sm:p-6 rounded-2xl border border-[var(--color-hairline)] shadow-xs font-tabular">
          <div class="text-xs text-[var(--color-ink-mute)] mb-1">Net Collections</div>
          <div class="text-2xl sm:text-4xl font-light text-emerald-600 dark:text-emerald-400">99.4%</div>
          <div class="text-[11px] text-[var(--color-ink-mute)] mt-1">+$1.84M cash inflow</div>
        </div>

        <div class="bg-[var(--color-card-bg)]/80 backdrop-blur-sm p-4 sm:p-6 rounded-2xl border border-[var(--color-hairline)] shadow-xs font-tabular flex flex-col justify-between">
          <div class="text-xs text-[var(--color-ink-mute)]">Staff Satisfaction</div>
          <div class="text-xl sm:text-2xl font-light text-[var(--color-ink)]">100% SLA</div>
          <div class="text-[11px] text-emerald-600 dark:text-emerald-400">Zero backlogs</div>
        </div>

      </div>

    </div>

  </div>
</section>
