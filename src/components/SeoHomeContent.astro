---
---

<section class="py-16 sm:py-20 bg-[var(--color-canvas)] border-t border-[var(--color-hairline)]" id="about-we-destine-tool">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header Badge & Main Title -->
    <div class="text-center max-w-3xl mx-auto mb-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary-deep)] text-xs font-semibold uppercase tracking-wider mb-4">
        About We Destine
      </div>
      <h2 class="font-display-xl text-3xl sm:text-4xl text-[var(--color-ink)] mb-4">
        Intelligent Medical Software & Healthcare Technology Solutions
      </h2>
    </div>

    <!-- Description Content Box -->
    <div class="max-w-4xl mx-auto bg-[var(--color-canvas-soft)] p-8 sm:p-12 rounded-2xl border border-[var(--color-hairline)] shadow-xs text-center space-y-6">
      <p class="text-base sm:text-xl font-light text-[var(--color-ink-secondary)] leading-relaxed">
        <strong class="text-[var(--color-ink)] font-normal">We Destine</strong> is a premier healthcare technology provider dedicated to developing cutting-edge medical software solutions. We specialize in empowering healthcare organizations, medical practices, and dental facilities with intelligent software platforms that streamline administrative operations, automate revenue cycle management, and enable seamless EHR data integration.
      </p>
      <p class="text-sm sm:text-base font-light text-[var(--color-ink-secondary)] leading-relaxed">
        Our medical software systems are built to eliminate billing complexities, enhance clinical workflow efficiency, and secure maximum financial returns so healthcare providers can focus entirely on patient care.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <button onclick="document.getElementById('audit-modal')?.classList.remove('hidden'); document.getElementById('audit-modal')?.classList.add('flex')" class="btn-primary-pill text-sm py-3 px-6 cursor-pointer">
          <span>Schedule Practice Audit</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>

        <a href="/contact" class="btn-secondary-pill text-sm py-3 px-6">
          <span>Contact Our Software Team</span>
        </a>
      </div>
    </div>

  </div>
</section>
