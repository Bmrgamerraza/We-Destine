---
const specialties = [
  {
    title: "Medical Practices & Clinics",
    subtitle: "Solo, Group & Multi-Specialty Practices",
    iconType: "clinic",
    badge: "Medical RCM",
    features: [
      "CPT & ICD-10 specialty coding",
      "Prior auth & eligibility verification",
      "Patient statement & portal management",
      "Secondary & tertiary claim recovery"
    ]
  },
  {
    title: "Dental Practices & DSOs",
    subtitle: "General Dentistry, Ortho & Oral Surgery",
    iconType: "dental",
    badge: "Dental RCM",
    features: [
      "CDT procedure coding & attachments",
      "Radiograph & periodontal charting proof",
      "DSO multi-location central billing",
      "Payer fee schedule negotiation"
    ]
  },
  {
    title: "Hospitals & Health Systems",
    subtitle: "Inpatient & Outpatient Facilities",
    iconType: "hospital",
    badge: "Enterprise RCM",
    features: [
      "Complex UB-04 & Institutional billing",
      "High-value claim denial resolution",
      "DRG & APC coding validation",
      "A/R aging recovery (>90 days)"
    ]
  },
  {
    title: "ASCs & Specialty Centers",
    subtitle: "Cardiology, Orthopedics, Radiology & More",
    iconType: "asc",
    badge: "Specialty Solutions",
    features: [
      "Implant & high-cost supply reimbursement",
      "Facility vs Professional fee splits",
      "Anesthesia time & unit coding",
      "Specialty payer audit defense"
    ]
  }
];
---

<section class="py-12 sm:py-20 bg-[var(--color-canvas)] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary-deep)] text-xs font-medium uppercase tracking-wider mb-3 sm:mb-4">
        Specialized Expertise
      </div>
      <h2 class="font-display-xl text-2xl sm:text-4xl text-[var(--color-ink)] mb-3 sm:mb-4">
        Tailored Solutions for Every Healthcare Sector
      </h2>
      <p class="text-sm sm:text-lg font-light text-[var(--color-ink-secondary)]">
        Generic billing fails due to specialty coding nuances. We Destine provides dedicated teams trained specifically in your specialty's payer rules.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {specialties.map(spec => (
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-between hover:border-[var(--color-primary)] hover:shadow-xl hover:shadow-[var(--color-primary)]/10 hover:-translate-y-1 transition-all duration-300 group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="p-3 rounded-xl bg-[var(--color-primary-bg-subdued-hover)]/50 border border-[var(--color-hairline)] group-hover:scale-105 transition-transform text-[var(--color-primary)]">
                {spec.iconType === 'clinic' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 0 0 4.5 2.6V8A5.5 5.5 0 0 0 10 13.5h0A5.5 5.5 0 0 0 15.5 8V2.6a.3.3 0 0 0-.3-.3h-1.4a.3.3 0 0 0-.3.3V8a3.5 3.5 0 0 1-7 0V2.6a.3.3 0 0 0-.3-.3z"/><path d="M10 13.5v4.2A3.3 3.3 0 0 0 13.3 21h2.4a3.3 3.3 0 0 0 3.3-3.3V16"/><circle cx="19" cy="16" r="2"/></svg>
                )}
                {spec.iconType === 'dental' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8.5 2 6 4 6 7c0 3 1.5 5.5 2 9 0.5 3.5 1.5 6 4 6s3.5-2.5 4-6c.5-3.5 2-6 2-9 0-3-2.5-5-6-5z"/></svg>
                )}
                {spec.iconType === 'hospital' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/><path d="M10 9h4"/><path d="M12 7v4"/></svg>
                )}
                {spec.iconType === 'asc' && (
                  <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                )}
              </div>
              <span class="text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary-deep)] font-mono">
                {spec.badge}
              </span>
            </div>

            <h3 class="font-medium text-xl text-[var(--color-ink)] mb-1 group-hover:text-[var(--color-primary)] transition-colors">
              {spec.title}
            </h3>
            
            <p class="text-xs text-[var(--color-ink-mute)] mb-6">
              {spec.subtitle}
            </p>

            <ul class="space-y-2.5 mb-6 text-xs text-[var(--color-ink-secondary)] font-light">
              {spec.features.map(f => (
                <li class="flex items-center gap-2">
                  <span class="text-[var(--color-primary)] font-bold">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <button onclick="document.getElementById('audit-modal')?.classList.remove('hidden'); document.getElementById('audit-modal')?.classList.add('flex')" class="w-full btn-secondary-pill text-xs py-2 cursor-pointer justify-center">
            Explore {spec.badge}
          </button>
        </div>
      ))}
    </div>

  </div>
</section>
