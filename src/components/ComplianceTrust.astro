---
const trustBadges = [
  { title: "HIPAA Compliant", desc: "100% Protected Health Information (PHI) encryption in transit & at rest." },
  { title: "SOC 2 Type II Certified", desc: "Audited security, availability, and processing integrity controls." },
  { title: "ISO 27001 Certified", desc: "International standard for information security management systems." },
  { title: "100% AAPC / AHIMA Coders", desc: "All medical and dental coders hold active US accredited credentials." },
  { title: "256-Bit SSL Encryption", desc: "Bank-grade cryptographic security across all EHR and payer integrations." },
  { title: "99.9% Uptime SLA", desc: "Enterprise infrastructure redundancy with zero operational downtime." }
];
---

<section class="py-20 bg-white relative border-t border-[var(--color-hairline)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary-deep)] text-xs font-medium uppercase tracking-wider mb-4">
        Uncompromising Security
      </div>
      <h2 class="font-display-xl text-3xl sm:text-4xl text-[var(--color-ink)] mb-4">
        Enterprise Compliance & Data Protection
      </h2>
      <p class="text-base sm:text-lg font-light text-[var(--color-ink-secondary)]">
        Your patient and financial data is safeguarded by strict enterprise security protocols, continuous auditing, and certified US compliance teams.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {trustBadges.map(badge => (
        <div class="p-6 rounded-2xl bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 text-lg font-bold">
            🛡️
          </div>
          <div>
            <h4 class="font-medium text-base text-[var(--color-ink)] mb-1">
              {badge.title}
            </h4>
            <p class="text-xs text-[var(--color-ink-mute)] font-light leading-relaxed">
              {badge.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
