---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero.jpg';
---

<section class="relative min-h-[540px] sm:min-h-[600px] flex items-center pt-20 pb-24 md:pt-28 md:pb-32 overflow-hidden bg-slate-950">
  
  <!-- Hero Background Image with Lightened Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={heroImg} 
      alt="Medical Software Platform Backdrop" 
      class="w-full h-full object-cover object-center opacity-65 filter brightness-95 saturate-[1.1]"
      loading="eager"
    />
    <!-- Lightened Soft Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/50 via-slate-950/35 to-slate-950/60"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center">
    
    <!-- Medical Software Pill Tag -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-sky-900/30 border border-sky-600/40 text-sky-300 text-xs font-medium uppercase tracking-wider mb-4 backdrop-blur-md shadow-md">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
      <span>Intelligent Medical Software Platform</span>
    </div>

    <!-- Clean, High-Impact Medical Software Headline -->
    <h1 class="text-2xl sm:text-4xl md:text-5xl font-light text-white tracking-tight leading-[1.15] mb-4">
      Advanced Medical Software for <br class="hidden sm:inline" />
      <span class="font-semibold text-sky-400">Modern Healthcare Practices</span>
    </h1>

    <!-- Medical Software Subtitle -->
    <p class="text-sm sm:text-base md:text-lg font-light text-slate-300 leading-relaxed mb-8 max-w-2xl mx-auto">
      We Destine provides powerful healthcare software solutions designed to automate clinical billing workflows, simplify practice management, and optimize revenue performance.
    </p>

    <!-- Single Main CTA Button -->
    <div class="flex justify-center">
      <button 
        onclick="document.getElementById('audit-modal')?.classList.remove('hidden'); document.getElementById('audit-modal')?.classList.add('flex')" 
        class="px-8 py-3.5 rounded-full bg-sky-700 hover:bg-sky-800 text-white font-medium text-base shadow-lg shadow-sky-900/50 hover:shadow-sky-800/60 transition-all duration-200 cursor-pointer flex items-center gap-2.5 group"
      >
        <span>Request Software Demo</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

  </div>
</section>



