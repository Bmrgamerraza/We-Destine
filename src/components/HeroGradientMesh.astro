---
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  
  <!-- Atmospheric Gradient Mesh Backdrop -->
  <div class="gradient-mesh-hero"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto mb-12">
      
      <!-- Subdued Pill Tag -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--color-primary-bg-subdued-hover)]/70 text-[var(--color-primary-deep)] text-xs font-semibold uppercase tracking-wider mb-6 border border-[var(--color-primary-soft)]/20 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-[var(--color-primary)] animate-pulse"></span>
        Intelligent Revenue Cycle Management
      </div>

      <!-- Display XXL Headline -->
      <h1 class="font-display-xxl text-4xl sm:text-5xl md:text-6xl text-[var(--color-ink)] mb-6 tracking-tight">
        Transforming Healthcare Operations Through <span class="text-[var(--color-primary)] font-normal italic">Intelligent RCM</span>
      </h1>

      <!-- Body Lead Text -->
      <p class="text-lg sm:text-xl font-light text-[var(--color-ink-secondary)] leading-relaxed mb-8 max-w-3xl mx-auto">
        We partner with medical practices, hospitals, and healthcare organizations to accelerate collections, eliminate claim denials, and optimize financial outcomes with technology-driven revenue solutions.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <button onclick="document.getElementById('audit-modal')?.classList.remove('hidden'); document.getElementById('audit-modal')?.classList.add('flex')" class="btn-primary-pill text-base py-3 px-6 w-full sm:w-auto cursor-pointer">
          <span>Schedule Practice Audit</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </button>

        <a href="#calculator" class="btn-secondary-pill text-base py-3 px-6 w-full sm:w-auto">
          <span>Calculate Revenue Impact</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
            <line x1="8" y1="6" x2="16" y2="6"></line>
            <line x1="16" y1="14" x2="16" y2="18"></line>
            <line x1="16" y1="10" x2="16" y2="10"></line>
            <line x1="12" y1="10" x2="12" y2="10"></line>
            <line x1="8" y1="10" x2="8" y2="10"></line>
            <line x1="12" y1="14" x2="12" y2="14"></line>
            <line x1="8" y1="14" x2="8" y2="14"></line>
            <line x1="12" y1="18" x2="12" y2="18"></line>
            <line x1="8" y1="18" x2="8" y2="18"></line>
          </svg>
        </a>
      </div>
    </div>

    <!-- Composited Dark App-Shell Mockup (Stripi Design Signature) -->
    <div class="relative max-w-5xl mx-auto">
      <div class="dark-dashboard-shell rounded-2xl overflow-hidden p-4 sm:p-6 text-white shadow-2xl">
        
        <!-- Window Chrome Bar -->
        <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
            <span class="ml-2 text-xs font-mono text-slate-400">wedestine-rcm-command-center v4.2</span>
          </div>
          <div class="flex items-center gap-3 text-xs text-slate-400">
            <span class="inline-flex items-center gap-1.5 bg-emerald-500/10 text-emerald-400 px-2.5 py-1 rounded-full border border-emerald-500/20 font-mono">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
              Live Sync Active
            </span>
            <span class="font-tabular text-slate-300">HIPAA Compliant</span>
          </div>
        </div>

        <!-- Metric KPI Cards in Tabular Numbers -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          
          <div class="bg-white/5 border border-white/10 rounded-xl p-4">
            <div class="text-xs text-slate-400 mb-1 font-light">Clean Claim Rate</div>
            <div class="text-2xl sm:text-3xl font-light font-tabular text-emerald-400">98.6%</div>
            <div class="text-[11px] text-emerald-400/80 mt-1 flex items-center gap-1 font-tabular">
              ↑ 3.2% vs industry avg
            </div>
          </div>

          <div class="bg-white/5 border border-white/10 rounded-xl p-4">
            <div class="text-xs text-slate-400 mb-1 font-light">Days in A/R</div>
            <div class="text-2xl sm:text-3xl font-light font-tabular text-white">18.4 <span class="text-xs text-slate-400 font-normal">days</span></div>
            <div class="text-[11px] text-emerald-400/80 mt-1 flex items-center gap-1 font-tabular">
              ↓ 14 days faster collections
            </div>
          </div>

          <div class="bg-white/5 border border-white/10 rounded-xl p-4">
            <div class="text-xs text-slate-400 mb-1 font-light">First-Pass Denials</div>
            <div class="text-2xl sm:text-3xl font-light font-tabular text-rose-400">&lt; 1.8%</div>
            <div class="text-[11px] text-emerald-400/80 mt-1 flex items-center gap-1 font-tabular">
              ↓ 78% denial reduction
            </div>
          </div>

          <div class="bg-white/5 border border-white/10 rounded-xl p-4">
            <div class="text-xs text-slate-400 mb-1 font-light">Net Collection Ratio</div>
            <div class="text-2xl sm:text-3xl font-light font-tabular text-[var(--color-primary-soft)]">99.1%</div>
            <div class="text-[11px] text-emerald-400/80 mt-1 flex items-center gap-1 font-tabular">
              +$142.5k revenue recovered
            </div>
          </div>

        </div>

        <!-- Composited Claims Feed & Live Graph Simulation -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          
          <div class="md:col-span-2 bg-white/5 border border-white/10 rounded-xl p-4">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-medium text-slate-300 uppercase tracking-wider">Claims Processing Stream</span>
              <span class="text-[11px] font-mono text-slate-400">Scrubbed in &lt;1.2s</span>
            </div>
            
            <div class="space-y-2 font-tabular text-xs">
              <div class="flex items-center justify-between p-2.5 rounded bg-white/5 border border-white/5">
                <div class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span class="font-mono text-slate-300">CLM-90428</span>
                  <span class="text-slate-400">Orthopedics · CPT 27447</span>
                </div>
                <div class="flex items-center gap-4">
                  <span class="text-white font-medium">$12,450.00</span>
                  <span class="bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded text-[10px] uppercase font-mono">Paid Clean</span>
                </div>
              </div>

              <div class="flex items-center justify-between p-2.5 rounded bg-white/5 border border-white/5">
                <div class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span class="font-mono text-slate-300">CLM-90429</span>
                  <span class="text-slate-400">Cardiology · CPT 93458</span>
                </div>
                <div class="flex items-center gap-4">
                  <span class="text-white font-medium">$4,820.00</span>
                  <span class="bg-emerald-500/20 text-emerald-300 px-2 py-0.5 rounded text-[10px] uppercase font-mono">Accepted</span>
                </div>
              </div>

              <div class="flex items-center justify-between p-2.5 rounded bg-white/5 border border-white/5">
                <div class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                  <span class="font-mono text-slate-300">CLM-90430</span>
                  <span class="text-slate-400">Dental DSO · CDT D2750</span>
                </div>
                <div class="flex items-center gap-4">
                  <span class="text-white font-medium">$1,350.00</span>
                  <span class="bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded text-[10px] uppercase font-mono">Scrubbed</span>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-white/5 border border-white/10 rounded-xl p-4 flex flex-col justify-between">
            <div>
              <div class="text-xs font-medium text-slate-300 uppercase tracking-wider mb-2">Automated AI Scrubber</div>
              <p class="text-xs font-light text-slate-400 leading-relaxed mb-4">
                Real-time validation against payer rules, NCCI edits, and specialty coding specs before submission.
              </p>
            </div>
            
            <div class="p-3 bg-[var(--color-primary-deep)]/30 border border-[var(--color-primary-soft)]/30 rounded-lg">
              <div class="flex items-center justify-between text-xs mb-1">
                <span class="text-slate-200">Scrubbing Accuracy</span>
                <span class="text-emerald-400 font-tabular font-bold">99.8%</span>
              </div>
              <div class="w-full bg-white/10 rounded-full h-1.5 overflow-hidden">
                <div class="bg-gradient-to-r from-[var(--color-primary)] to-emerald-400 h-full w-[99.8%]"></div>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
