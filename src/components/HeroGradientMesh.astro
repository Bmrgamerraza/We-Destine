---
// Hero background served directly from the public folder
const heroImg = '/hero.jpg';
---

<section class="relative min-h-[560px] sm:min-h-[640px] flex items-center pt-20 pb-24 md:pt-28 md:pb-32 overflow-hidden bg-slate-950">

  <!-- Hero Background Image with Enhanced Gradient Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src={heroImg}
      alt="Medical Software Platform Backdrop"
      class="w-full h-full object-cover object-center opacity-75 filter brightness-[0.88] saturate-[1.1]"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <!-- Enhanced Multi-Layer Gradient Overlay with Vignette -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-950/60 via-slate-950/45 to-slate-950/70"></div>
    <div class="absolute inset-0 bg-gradient-radial from-transparent via-transparent to-slate-950/35"></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center">

    <!-- Medical Software Pill Tag with Animation -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sky-900/35 border border-sky-500/50 text-sky-200 text-xs font-medium uppercase tracking-wider mb-5 backdrop-blur-lg shadow-lg shadow-sky-900/30 animate-fade-in-up">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse shadow-sm shadow-sky-400"></span>
      <span>Intelligent Medical Software Platform</span>
    </div>

    <!-- Enhanced High-Impact Medical Software Headline -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-[4rem] font-light text-white tracking-tight leading-[1.1] mb-5 animate-fade-in-up delay-100" style="text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);">
      Advanced Medical Software for <br class="hidden sm:inline" />
      <span class="font-semibold text-sky-400 bg-gradient-to-r from-sky-400 to-sky-300 bg-clip-text text-transparent">Modern Healthcare Practices</span>
    </h1>

    <!-- Enhanced Medical Software Subtitle -->
    <p class="text-base sm:text-lg md:text-xl font-light text-slate-200 leading-relaxed mb-9 max-w-2xl mx-auto animate-fade-in-up delay-200" style="text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);">
      We Destine provides powerful healthcare software solutions designed to automate clinical billing workflows, simplify practice management, and optimize revenue performance.
    </p>

    <!-- Enhanced CTA Button with Glow Effect -->
    <div class="flex justify-center animate-fade-in-up delay-300">
      <button
        onclick="document.getElementById('audit-modal')?.classList.remove('hidden'); document.getElementById('audit-modal')?.classList.add('flex')"
        class="hero-cta-btn px-9 py-4 rounded-full bg-sky-600 hover:bg-sky-700 text-white font-semibold text-base shadow-xl shadow-sky-900/60 hover:shadow-2xl hover:shadow-sky-700/70 transition-all duration-300 cursor-pointer flex items-center gap-3 group hover:scale-[1.03] active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 focus:ring-offset-slate-950"
      >
        <span>Request Software Demo</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white transition-transform duration-300 group-hover:translate-x-1.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

  </div>
</section>

<style>
  /* Radial gradient for vignette effect */
  .bg-gradient-radial {
    background: radial-gradient(ellipse at center, transparent 0%, rgba(15, 23, 42, 0.3) 100%);
  }

  /* Enhanced CTA button with glow animation */
  .hero-cta-btn {
    position: relative;
    overflow: hidden;
  }

  .hero-cta-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(45deg, transparent, rgba(255, 255, 255, 0.1), transparent);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .hero-cta-btn:hover::before {
    transform: translateX(100%);
  }

  /* Gradient text support */
  .bg-clip-text {
    -webkit-background-clip: text;
    background-clip: text;
  }
</style>



