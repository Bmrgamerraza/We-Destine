---
const integrations = [
  { name: "Epic Systems", category: "medical", type: "Health System & Hospital EHR", status: "Native FHIR API Integration" },
  { name: "Oracle Cerner", category: "medical", type: "Enterprise EHR Infrastructure", status: "Bi-Directional Sync" },
  { name: "athenahealth", category: "medical", type: "Cloud Practice Management", status: "Direct API Connector" },
  { name: "eClinicalWorks", category: "medical", type: "Ambulatory & Specialist EHR", status: "Automated Billing Bridge" },
  { name: "NextGen Healthcare", category: "medical", type: "Specialty Medical EHR", status: "Real-Time Scrubbing Sync" },
  { name: "Tebra / Kareo", category: "medical", type: "Independent Practice EHR", status: "Direct API Connector" },
  { name: "DrChrono", category: "medical", type: "Mobile & iPad Medical EHR", status: "Native Integration" },
  { name: "Veradigm / Allscripts", category: "medical", type: "Multi-Specialty EHR", status: "Bi-Directional Sync" },
  { name: "OpenDental", category: "dental", type: "Dental Practice Management", status: "Direct Database Bridge" },
  { name: "Dentrix (Henry Schein)", category: "dental", type: "DSO & Dental Practice PMS", status: "CDT Code Auto-Scrubber" },
  { name: "Eaglesoft (Patterson)", category: "dental", type: "Clinical & Dental Billing PMS", status: "Real-Time ERA Sync" },
  { name: "Carestream Dental", category: "dental", type: "Specialty Oral Surgery PMS", status: "Automated Claim Scrubbing" }
];
---

<section id="integrations" class="py-12 sm:py-20 bg-[var(--color-canvas-soft)] relative border-t border-[var(--color-hairline)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary-deep)] text-xs font-medium uppercase tracking-wider mb-3 sm:mb-4">
        Zero-Friction Technology
      </div>
      <h2 class="font-display-xl text-2xl sm:text-4xl text-[var(--color-ink)] mb-3 sm:mb-4">
        Seamless Integration with Your Existing EHR & PMS
      </h2>
      <p class="text-sm sm:text-lg font-light text-[var(--color-ink-secondary)]">
        No need to replace your software. We Destine connects directly via bi-directional APIs, HL7, and FHIR standards without disrupting clinical workflow.
      </p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-8 sm:mb-10">
      <button type="button" data-filter="all" class="ehr-filter-btn active px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-full border transition-all cursor-pointer font-medium border-[var(--color-primary)] bg-[var(--color-primary)] text-white shadow-xs">
        All Systems
      </button>
      <button type="button" data-filter="medical" class="ehr-filter-btn px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-full border transition-all cursor-pointer font-medium border-[var(--color-hairline)] bg-[var(--color-card-bg)] text-[var(--color-ink-secondary)] hover:border-gray-400">
        Medical EHRs
      </button>
      <button type="button" data-filter="dental" class="ehr-filter-btn px-3 sm:px-4 py-1.5 sm:py-2 text-xs sm:text-sm rounded-full border transition-all cursor-pointer font-medium border-[var(--color-hairline)] bg-[var(--color-card-bg)] text-[var(--color-ink-secondary)] hover:border-gray-400">
        Dental & DSO Systems
      </button>
    </div>

    <!-- Grid Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      {integrations.map(item => (
        <div data-cat={item.category} class="ehr-card bg-[var(--color-card-bg)] border border-[var(--color-hairline)] rounded-xl p-4 sm:p-5 hover:shadow-md hover:border-[var(--color-primary-soft)]/50 transition-all">
          <div class="flex items-center justify-between mb-3">
            <div class="w-8 h-8 rounded-lg bg-[var(--color-primary-bg-subdued-hover)]/40 border border-[var(--color-hairline)] flex items-center justify-center text-[var(--color-primary-deep)] font-bold text-xs">
              <svg class="w-4 h-4 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <span class="font-tabular text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              Verified Sync
            </span>
          </div>

          <h4 class="font-medium text-base text-[var(--color-ink)] mb-1">
            {item.name}
          </h4>
          
          <div class="text-xs text-[var(--color-ink-mute)] mb-3">
            {item.type}
          </div>

          <div class="pt-3 border-t border-[var(--color-hairline)] flex items-center gap-1.5 text-[11px] text-[var(--color-primary-deep)] font-light">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)]"></span>
            <span>{item.status}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom FHIR & HL7 Banner -->
    <div class="mt-10 p-6 bg-[var(--color-card-bg)] border border-[var(--color-hairline)] rounded-xl flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-[var(--color-primary-bg-subdued-hover)]/40 flex items-center justify-center text-[var(--color-primary)] font-semibold shrink-0">
          <svg class="w-5 h-5 text-[var(--color-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22v-5"/><path d="M9 8V2"/><path d="M15 8V2"/><path d="M18 8v5a6 6 0 0 1-12 0V8z"/></svg>
        </div>
        <div>
          <div class="font-medium text-sm text-[var(--color-ink)]">Custom / Proprietary EHR System?</div>
          <div class="text-xs text-[var(--color-ink-mute)]">We build custom HL7 / FHIR API connectors for specialized healthcare software in under 14 days.</div>
        </div>
      </div>
      <button onclick="document.getElementById('audit-modal')?.classList.remove('hidden'); document.getElementById('audit-modal')?.classList.add('flex')" class="btn-secondary-pill text-xs py-2 px-4 cursor-pointer whitespace-nowrap">
        Request Custom Integration
      </button>
    </div>

  </div>
</section>

<script>
  // Filter buttons logic
  const filterBtns = document.querySelectorAll('.ehr-filter-btn');
  const ehrCards = document.querySelectorAll('.ehr-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('border-[var(--color-primary)]', 'bg-[var(--color-primary)]', 'text-white', 'shadow-xs');
        b.classList.add('border-[var(--color-hairline)]', 'bg-[var(--color-card-bg)]', 'text-[var(--color-ink-secondary)]');
      });
      btn.classList.remove('border-[var(--color-hairline)]', 'bg-[var(--color-card-bg)]', 'text-[var(--color-ink-secondary)]');
      btn.classList.add('border-[var(--color-primary)]', 'bg-[var(--color-primary)]', 'text-white', 'shadow-xs');

      const filter = (btn as HTMLButtonElement).dataset.filter;

      ehrCards.forEach(card => {
        const cat = (card as HTMLElement).dataset.cat;
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = 'block';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
