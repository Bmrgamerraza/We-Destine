---
import Layout from '../layouts/Layout.astro';
import ComplianceTrust from '../components/ComplianceTrust.astro';
---

<Layout 
  title="Dental RCM & DSO Solutions | We Destine"
  description="Specialized dental revenue cycle management, CDT coding, radiography proof attachments, and multi-location DSO billing solutions."
>
  <section class="relative pt-16 pb-20 overflow-hidden bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]">
    <div class="gradient-mesh-hero"></div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary-deep)] text-xs font-semibold uppercase tracking-wider mb-4">
        Dental & DSO Revenue Optimization
      </div>

      <h1 class="font-display-xxl text-4xl sm:text-5xl text-[var(--color-ink)] mb-6">
        Precision Dental RCM for Single Practices & DSOs
      </h1>

      <p class="text-lg font-light text-[var(--color-ink-secondary)] leading-relaxed mb-8">
        Eliminate dental claim rejections caused by missing x-rays, narrative errors, or CDT code mismatches. Scalable solutions tailored for general dentistry, oral surgery, and multi-location DSOs.
      </p>

      <button onclick="document.getElementById('audit-modal')?.classList.remove('hidden'); document.getElementById('audit-modal')?.classList.add('flex')" class="btn-primary-pill text-base py-3 px-8 cursor-pointer">
        Get Dental RCM Audit
      </button>
    </div>
  </section>

  <!-- Dental Features -->
  <section class="py-20 bg-[var(--color-canvas)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="p-8 rounded-2xl bg-[var(--color-card-bg)] border border-[var(--color-hairline)] shadow-xs">
          <div class="p-3 w-12 h-12 rounded-xl bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary)] mb-4 flex items-center justify-center">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8.5 2 6 4 6 7c0 3 1.5 5.5 2 9 0.5 3.5 1.5 6 4 6s3.5-2.5 4-6c.5-3.5 2-6 2-9 0-3-2.5-5-6-5z"/></svg>
          </div>
          <h3 class="font-medium text-xl text-[var(--color-ink)] mb-2">CDT Coding & Narratives</h3>
          <p class="text-sm font-light text-[var(--color-ink-secondary)] leading-relaxed mb-4">
            Expert CDT procedure coding backed by required clinical narratives, periodontal charting, and digital radiograph attachments.
          </p>
          <div class="text-xs font-tabular text-[var(--color-primary-deep)]">✓ Zero attachment rejection rate</div>
        </div>

        <div class="p-8 rounded-2xl bg-[var(--color-card-bg)] border border-[var(--color-hairline)] shadow-xs">
          <div class="p-3 w-12 h-12 rounded-xl bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary)] mb-4 flex items-center justify-center">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/></svg>
          </div>
          <h3 class="font-medium text-xl text-[var(--color-ink)] mb-2">Multi-Location DSO Centralization</h3>
          <p class="text-sm font-light text-[var(--color-ink-secondary)] leading-relaxed mb-4">
            Unified billing architecture for Dental Support Organizations (DSOs), consolidating posting, insurance verification, and A/R across dozens of practice locations.
          </p>
          <div class="text-xs font-tabular text-[var(--color-primary-deep)]">✓ Centralized DSO executive reporting</div>
        </div>

        <div class="p-8 rounded-2xl bg-[var(--color-card-bg)] border border-[var(--color-hairline)] shadow-xs">
          <div class="p-3 w-12 h-12 rounded-xl bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary)] mb-4 flex items-center justify-center">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          </div>
          <h3 class="font-medium text-xl text-[var(--color-ink)] mb-2">Patient Financing & Self-Pay</h3>
          <p class="text-sm font-light text-[var(--color-ink-secondary)] leading-relaxed mb-4">
            Automated SMS e-statements and integrated dental payment plan administration to minimize patient write-offs.
          </p>
          <div class="text-xs font-tabular text-[var(--color-primary-deep)]">✓ 35% faster patient collections</div>
        </div>

      </div>

    </div>
  </section>

  <ComplianceTrust />
</Layout>
