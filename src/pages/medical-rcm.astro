---
import Layout from '../layouts/Layout.astro';
import RoiCalculator from '../components/RoiCalculator.astro';
import ComplianceTrust from '../components/ComplianceTrust.astro';
---

<Layout 
  title="Medical RCM Solutions & Billing Software | We Destine"
  description="End-to-end medical revenue cycle management with We Destine: automated clean claim scrubbing, certified CPT coding, and 48-hour denial resolution."
  canonical="https://wedestine.com/medical-rcm"
>
  <section class="relative pt-16 pb-20 overflow-hidden bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)]">
    <div class="gradient-mesh-hero"></div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary-deep)] text-xs font-semibold uppercase tracking-wider mb-4">
        Specialist Medical Revenue Management
      </div>

      <h1 class="font-display-xxl text-4xl sm:text-5xl text-[var(--color-ink)] mb-6">
        Intelligent Medical RCM Built for Physician Growth
      </h1>

      <p class="text-lg font-light text-[var(--color-ink-secondary)] leading-relaxed mb-8">
        From outpatient specialty clinics to regional health networks, We Destine eliminates medical billing bottlenecks, slashes claims denials below 1.8%, and speeds up A/R collections.
      </p>

      <button onclick="document.getElementById('audit-modal')?.classList.remove('hidden'); document.getElementById('audit-modal')?.classList.add('flex')" class="btn-primary-pill text-sm sm:text-base py-2.5 sm:py-3 px-6 sm:px-8 w-full sm:w-auto cursor-pointer justify-center">
        Get Medical Practice Audit
      </button>
    </div>
  </section>

  <!-- Medical Point Solutions Grid -->
  <section class="py-20 bg-[var(--color-canvas)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="font-display-xl text-3xl sm:text-4xl text-[var(--color-ink)] mb-4">
          Complete Medical Revenue Cycle Capabilities
        </h2>
        <p class="text-base font-light text-[var(--color-ink-secondary)]">
          Deploy our full end-to-end service or select individual point solutions to fix specific operational vulnerabilities.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="p-8 rounded-2xl bg-[var(--color-card-bg)] border border-[var(--color-hairline)] shadow-xs">
          <div class="p-3 w-12 h-12 rounded-xl bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary)] mb-4 flex items-center justify-center">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </div>
          <h3 class="font-medium text-xl text-[var(--color-ink)] mb-2">Medical Billing & Clearinghouse</h3>
          <p class="text-sm font-light text-[var(--color-ink-secondary)] leading-relaxed mb-4">
            Sub-second electronic claim scrubbing against 40,000+ commercial and government payer rules prior to clearinghouse transmission.
          </p>
          <ul class="text-xs space-y-2 text-[var(--color-ink-mute)] font-light font-tabular">
            <li>✓ 98.6% first-pass clean claim rate</li>
            <li>✓ Secondary & tertiary payer coordination</li>
            <li>✓ Daily ERA payment posting</li>
          </ul>
        </div>

        <div class="p-8 rounded-2xl bg-[var(--color-card-bg)] border border-[var(--color-hairline)] shadow-xs">
          <div class="p-3 w-12 h-12 rounded-xl bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary)] mb-4 flex items-center justify-center">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 0 0 4.5 2.6V8A5.5 5.5 0 0 0 10 13.5h0A5.5 5.5 0 0 0 15.5 8V2.6a.3.3 0 0 0-.3-.3h-1.4a.3.3 0 0 0-.3.3V8a3.5 3.5 0 0 1-7 0V2.6a.3.3 0 0 0-.3-.3z"/><path d="M10 13.5v4.2A3.3 3.3 0 0 0 13.3 21h2.4a3.3 3.3 0 0 0 3.3-3.3V16"/><circle cx="19" cy="16" r="2"/></svg>
          </div>
          <h3 class="font-medium text-xl text-[var(--color-ink)] mb-2">ICD-10 & CPT Medical Coding</h3>
          <p class="text-sm font-light text-[var(--color-ink-secondary)] leading-relaxed mb-4">
            Certified AAPC & AHIMA coders ensure complete clinical documentation compliance, eliminating under-coding and audit exposure.
          </p>
          <ul class="text-xs space-y-2 text-[var(--color-ink-mute)] font-light font-tabular">
            <li>✓ 100% certified specialty coders</li>
            <li>✓ CCI edit validation</li>
            <li>✓ Operative report parsing</li>
          </ul>
        </div>

        <div class="p-8 rounded-2xl bg-[var(--color-card-bg)] border border-[var(--color-hairline)] shadow-xs">
          <div class="p-3 w-12 h-12 rounded-xl bg-[var(--color-primary-bg-subdued-hover)] text-[var(--color-primary)] mb-4 flex items-center justify-center">
            <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 class="font-medium text-xl text-[var(--color-ink)] mb-2">Denial Appeals Engine</h3>
          <p class="text-sm font-light text-[var(--color-ink-secondary)] leading-relaxed mb-4">
            Aggressive denial management protocols that overturn wrongfully denied medical claims within 48 hours of ERA receipt.
          </p>
          <ul class="text-xs space-y-2 text-[var(--color-ink-mute)] font-light font-tabular">
            <li>✓ 94% overturn success rate</li>
            <li>✓ Payer-specific appeal templates</li>
            <li>✓ Timely filing deadline alerts</li>
          </ul>
        </div>

      </div>

    </div>
  </section>

  <RoiCalculator />
  <ComplianceTrust />
</Layout>
